#!/bin/sh
#
# Thin wrapper, mirroring build-one, around the mysql-rpm-builder binary's
# git-build-one subcommand: builds a src.rpm directly from a mysql-server git
# tag, without ever downloading Oracle's official src.rpm.
#
#     ./build-rpm-from-git [-o dir] [-no-bison] <os> <tag>
#     e.g. ./build-rpm-from-git ol10 mysql-9.7.1
#
# See `mysql-rpm-builder git-build-one -h`-equivalent usage in go/cmd/main.go
# and go/gitsteps for the implementation. Build the binary first with:
# go build -o mysql-rpm-builder ./go/cmd
#
dir=$(cd "$(dirname "$0")" && pwd)
bin=$dir/mysql-rpm-builder

if [ ! -x "$bin" ]; then
	echo "ERROR: $bin not found or not executable; build it with:" >&2
	echo "    (cd $dir && go build -o mysql-rpm-builder ./go/cmd)" >&2
	exit 1
fi

exec "$bin" git-build-one "$@"
