diff --git a/packaging/rpm-oel/mysql.spec.in b/packaging/rpm-oel/mysql.spec.in
index 08afa2d..b21994f 100644
--- a/packaging/rpm-oel/mysql.spec.in
+++ b/packaging/rpm-oel/mysql.spec.in
@@ -871,7 +871,18 @@ mkdir debug
 (
   cd debug
   # Attempt to remove any optimisation flags from the debug build
-  optflags=$(echo "%{optflags}" | sed -e 's/-O2 / /' -e 's/-Wp,-D_FORTIFY_SOURCE=2/ /' -e 's/%{_lto_cflags}/ /')
+%if 0%{?el10}
+  # %{optflags} here defines _FORTIFY_SOURCE via
+  # "-Wp,-U_FORTIFY_SOURCE,-D_FORTIFY_SOURCE=3", not the older
+  # "-Wp,-D_FORTIFY_SOURCE=2" the strip below matches, so it survives and
+  # this -O-less build fails under -Werror (glibc: "_FORTIFY_SOURCE
+  # requires compiling with optimization (-O)"). See git-build-config.yaml's
+  # mysql-8.0.46 entry for the confirming build.
+%global fortify_extra_strip -e 's/-Wp,-U_FORTIFY_SOURCE,-D_FORTIFY_SOURCE=[0-9]*/ /'
+%else
+%global fortify_extra_strip %{nil}
+%endif # el10
+  optflags=$(echo "%{optflags}" | sed -e 's/-O2 / /' -e 's/-Wp,-D_FORTIFY_SOURCE=2/ /' %{fortify_extra_strip} -e 's/%{_lto_cflags}/ /')
   %{cmake3} ../%{src_dir} \
            -DBUILD_CONFIG=mysql_release \
            -DINSTALL_LAYOUT=RPM \
